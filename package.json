{
  "name": "@cstrlcs/configs",
  "version": "8.0.0",
  "description": "Strict configurations for Oxlint/Oxfmt and TypeScript.",
  "keywords": [
    "configs",
    "oxc",
    "oxfmt",
    "oxlint",
    "tsconfig",
    "typescript"
  ],
  "license": "MIT",
  "author": "Lucas Castro (https://github.com/cstrlcs/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cstrlcs/configs.git"
  },
  "bin": {
    "cstrlcs-configs": "main.sh"
  },
  "files": [
    ".vscode",
    "oxlint",
    "oxfmt",
    "tsconfig"
  ],
  "type": "module",
  "main": "main.sh",
  "exports": {
    "./oxlint/*": "./oxlint/*",
    "./oxfmt/*": "./oxfmt/*",
    "./tsconfig/*": "./tsconfig/*"
  },
  "scripts": {
    "build": "bun ./src/generators/oxlint.ts",
    "release": "bumpp",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "bumpp": "12.2.2",
    "typescript": "7.0.2",
    "zod": "4.5.1"
  },
  "peerDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
