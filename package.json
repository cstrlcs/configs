{
  "name": "@cstrlcs/configs",
  "version": "7.1.0",
  "description": "Strict configurations for Oxlint/Oxfmt and TypeScript.",
  "keywords": [
    "configs",
    "oxc",
    "oxfmt",
    "oxlint",
    "tsconfig",
    "typescript"
  ],
  "license": "MIT",
  "author": "Lucas Castro (https://github.com/cstrlcs/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cstrlcs/configs.git"
  },
  "bin": {
    "cstrlcs-configs": "./main.sh"
  },
  "files": [
    ".vscode",
    "oxlint",
    "oxfmt",
    "tsconfig"
  ],
  "type": "module",
  "main": "main.sh",
  "scripts": {
    "build": "bun ./src/generators/oxlint.ts",
    "release": "bumpp",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "bumpp": "11.0.1",
    "typescript": "6.0.2",
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.18.1"
  }
}
