{
  "name": "@cstrlcs/configs",
  "version": "9.5.1",
  "description": "Strict configurations for Oxlint/Oxfmt and TypeScript.",
  "keywords": [
    "configs",
    "oxc",
    "oxfmt",
    "oxlint",
    "tsconfig",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "author": "Lucas Castro (https://github.com/cstrlcs/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cstrlcs/configs.git"
  },
  "bin": {
    "cstrlcs-configs": "src/cli/main.ts"
  },
  "files": [
    ".vscode",
    "oxlint",
    "oxfmt",
    "plugins",
    "src/cli",
    "!src/cli/**/*.test.ts",
    "!src/cli/test-fixture.ts",
    "tsconfig"
  ],
  "type": "module",
  "exports": {
    "./oxlint/*": "./oxlint/*",
    "./oxfmt/*": "./oxfmt/*",
    "./plugins/*": "./plugins/*",
    "./tsconfig/*": "./tsconfig/*"
  },
  "scripts": {
    "build": "bun ./src/generators/plugins.ts && bun ./src/generators/oxfmt.ts && bun ./src/generators/oxlint.ts",
    "release": "publi.sh",
    "check": "bun run lint && bun run format:check && tsc --noEmit && bun run test",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix; s=$?; oxfmt; exit $s",
    "test": "vitest run && bun test src/cli"
  },
  "dependencies": {
    "oxc-resolver": "11.24.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "zod": "4.5.1"
  },
  "peerDependencies": {
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
